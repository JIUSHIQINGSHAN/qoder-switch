{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qoder-switch",
  "version": "0.1.6",
  "identifier": "com.qoderswitch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qoder Switch · Qoder 多账号切换",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* https://github.com https://*.githubusercontent.com;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QkFFQzg0RkVDODRCNDkKUldSSlM4aitoT3k2ZEdUR3Uwa3ZkVkZlVmwwSVFwT2lyeVprQ0QrOXhuWG54cVRhRThoYWFERC8K",
      "endpoints": [
        "https://github.com/JIUSHIQINGSHAN/qoder-switch/releases/latest/download/latest.json",
        "https://github.com/JIUSHIQINGSHAN/qoder-switch/releases/latest/download/latest-windows-x86_64.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
